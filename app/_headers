# Cloudflare Pages — politique de cache.
# Les fichiers d'assets portent une empreinte dans leur nom (index-XXXX.js) :
# ils peuvent être mis en cache définitivement.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos et polices : noms stables, mais contenu qui ne change qu'au redéploiement.
# Un an de cache avec revalidation en arrière-plan.
/photos/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
